# Copy to .env.local (gitignored) and edit.

# Where the audience hub runs (server/). The presenter's local deck connects
# outward to it; the QR slide encodes the same host with /join.
#   lecture:   wss://agentic.cs50.io
#   local hub: ws://localhost:8099   (PORT=8099 pnpm hub)
# Unset, the deck uses its own origin, which is right for the hosted copy.
VITE_HUB_URL=wss://agentic.cs50.io
