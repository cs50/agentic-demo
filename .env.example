# Copy to .env.local (gitignored) and fill in. Read by three things:
#   the deck under `pnpm dev`      (Vite: the VITE_* lines)
#   pnpm hub / pnpm hub:loadtest   (Node --env-file: PRESENTER_TOKEN, PORT)
# A production build (CI, the hosted deck) never sees this file.

# Where the audience hub runs. The presenter's local deck connects outward to
# it, and the QR slide encodes the same host with /join.
#   lecture:   wss://agentic.cs50.io
#   local hub: ws://localhost:8080   (pnpm hub)
VITE_HUB_URL=wss://agentic.cs50.io

# The presenter's secret. For the hosted hub, the value of the environment
# property PRESENTER_TOKEN (`eb printenv`). For a local hub, anything: the hub
# reads PRESENTER_TOKEN, the deck reads VITE_PRESENTER_TOKEN, and the second
# line keeps them equal (Vite expands ${...}). Only the dev server reads the
# VITE_ copy, so anyone who can load your dev deck is a presenter; don't
# combine with `slidev --remote` in a room.
PRESENTER_TOKEN=change-me
VITE_PRESENTER_TOKEN=${PRESENTER_TOKEN}

# Local hub port (default 8080).
# PORT=8080
